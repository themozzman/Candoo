AUTH_SECRET=change_me
ENV=production
SESSION_TTL_SECONDS=86400
RESET_TOKEN_TTL_SECONDS=3600
VERIFY_CODE_TTL_SECONDS=600
CORS_ORIGINS=https://your-frontend-domain
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_PATH=/path/to/app.db
REPORTS_PATH=/path/to/reports
FLOWS_PATH=/path/to/flows
RESET_LINK_BASE=https://your-frontend-domain
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
RESEND_API_KEY=your_resend_api_key
ADMIN_RESET_TOKEN=change_me
ADMIN_FLOW_TOKEN=change_me
ADMIN_EMAILS=admin@example.com
OPENAI_API_KEY=change_me
OPENAI_MODEL=gpt-4o-mini
VITE_API_BASE=https://your-backend-domain
